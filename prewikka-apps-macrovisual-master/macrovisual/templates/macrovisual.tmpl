<!-- <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css"> -->
<link rel="stylesheet" href="https://unpkg.com/leaflet/dist/leaflet.css" />
<link rel="stylesheet" type="text/css" href="macrovisual/css/macrovisual.css"> 

<div style="position: relative">

    <div id="initDiv" onclick="initMap()">
        <div id="instructions-div">
            <h2 id="instruction-text">Click to open the map</h2>
        </div>
    </div>
    
    <div class="popup-mask" id="popup-mask" onclick="closePopup()"></div>
    <div class="popup-width placement-popup" id="placement-popup">
        <div class="placement-content">
            <h3 class="my-0">Add a new marker:</h3>
    
            <div class="flex flex-col gap-half">
                <label class="font-bold" for="popup-name">Name:</label>
                <input class="custom-input" type="text" id="popup-name">
            </div>
    
            <div class="flex gap-1">
                <div class="flex flex-col gap-half input-div-width">
                    <label class="font-bold" for="popup-icon-type">Map Icon:</label>
                    <select class="custom-select" id="popup-icon-type">
                        <option value="building">Building</option>
                        <option value="nuclearPlant">Nuclear Plant</option>
                        <option value="factory">Factory</option>
                        <option value="airport">Airport</option>
                        <option value="hospital">Hospital</option>
                    </select>
                </div>
                <div class="flex flex-col gap-half input-div-width">
                    <label class="font-bold" for="start-position">Connect To:</label>
                    <select class="custom-select" id="start-position">
                        <option value="none">Unlinked</option>
                    </select>
                </div>
            </div>
            <div class="flex gap-1">
                <div class="flex flex-col gap-half input-div-width">
                    <label class="font-bold" for="popup-lat">Latitude:</label>
                    <input class="custom-input" type="text" id="popup-lat">
                </div>
                <div class="flex flex-col gap-half input-div-width">
                    <label class="font-bold" for="popup-lng">Longitude:</label>
                    <input class="custom-input" type="text" id="popup-lng">
                </div>
            </div>
            <div class="flex gap-half content-right">
                <button type="button" class="custom-button" onclick="closePopup()">Cancel</button>
                <button type="button" class="custom-button" onclick="placeMarker()">Confirm</button>
            </div>
        </div>
    </div>
    
    <div class="popup-width details-popup" id="details-popup">
        <div class="details-content">
            <div class="flex content-between align-center">
                <h3 class="my-0">Site details:</h3>
                <span class="flex align-center cursor-pointer" onclick="closePopup()"><svg  width="1.3rem" clip-rule="evenodd" fill-rule="evenodd" stroke-linejoin="round" stroke-miterlimit="2" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="m12 10.93 5.719-5.72c.146-.146.339-.219.531-.219.404 0 .75.324.75.749 0 .193-.073.385-.219.532l-5.72 5.719 5.719 5.719c.147.147.22.339.22.531 0 .427-.349.75-.75.75-.192 0-.385-.073-.531-.219l-5.719-5.719-5.719 5.719c-.146.146-.339.219-.531.219-.401 0-.75-.323-.75-.75 0-.192.073-.384.22-.531l5.719-5.719-5.72-5.719c-.146-.147-.219-.339-.219-.532 0-.425.346-.749.75-.749.192 0 .385.073.531.219z"/></svg></span>
            </div>
    
            <div class="flex flex-col gap-half">
                <label class="font-bold" for="site-name">Name:</label>
                <input class="custom-input" type="text" id="details-name" readonly>
            </div>
    
            <label class="font-bold">Alerts:</label>
    
            <div class="alerts-div">
                <div class="high-alert">
                    <p>High</p>
                    <p class="alert-number">11</p>
                </div>
                <div class="medium-alert">
                    <p>Medium</p>
                    <p class="alert-number">680</p>
                </div>
                <div class="low-alert">
                    <p>Low</p>
                    <p class="alert-number">100</p>
                </div>
                <div class="info-alert">
                    <p>Info</p>
                    <p class="alert-number">0</p>
                </div>
            </div>
    
            <div class="flex content-between">
                <button type="button" class="details-button details-delete" id="delete-marker">Remove marker</button>
                <button type="button" class="details-button details-rename" id="modify-marker">Rename</button>
                <button type="button" class="details-button details-rename" id="save-marker" style="display: none;">Save</button>
            </div>
        </div>
    </div>
    
    <div class="container-map">
        <div id="map"></div>
        <div class="controls">
            <div class="controls-div">
                <div>
                    <button type="button" id="edit-mode" title="Edit connections">
                        <svg width="22px" height="22px" clip-rule="evenodd" fill-rule="evenodd" stroke-linejoin="round" stroke-miterlimit="2" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="m4.481 15.659c-1.334 3.916-1.48 4.232-1.48 4.587 0 .528.46.749.749.749.352 0 .668-.137 4.574-1.492zm1.06-1.061 3.846 3.846 11.321-11.311c.195-.195.293-.45.293-.707 0-.255-.098-.51-.293-.706-.692-.691-1.742-1.74-2.435-2.432-.195-.195-.451-.293-.707-.293-.254 0-.51.098-.706.293z" fill-rule="nonzero"/></svg>
                    </button>
                    <button type="button" id="save-mode" style="display: none;" title="End modifications">
                        <svg xmlns="http://www.w3.org/2000/svg" width="22px" height="22px" viewBox="0 0 24 24"><path d="M20.303 4.846l.882.882-12.22 12.452-6.115-5.93.902-.902 5.303 5.028 11.248-11.53zm-.018-2.846l-11.285 11.567-5.286-5.011-3.714 3.716 9 8.728 15-15.285-3.715-3.715z"/></svg>
                    </button>
                </div>
                <div>
                    <button type="button" id="export-button" title="Export map">
                        <svg width="22px" height="22px"  xmlns="http://www.w3.org/2000/svg" fill-rule="evenodd" clip-rule="evenodd"><path d="M9 16h-8v6h22v-6h-8v-1h9v8h-24v-8h9v1zm11 2c.552 0 1 .448 1 1s-.448 1-1 1-1-.448-1-1 .448-1 1-1zm-7.5 0h-1v-14.883l-4.735 5.732-.765-.644 6.021-7.205 5.979 7.195-.764.645-4.736-5.724v14.884z"/></svg>
                    </button>
                </div>
                <div>
                    <button type="button" id="import-button" title="Import map">
                        <svg width="22px" height="22px" xmlns="http://www.w3.org/2000/svg" fill-rule="evenodd" clip-rule="evenodd"><path d="M6 16h-5v6h22v-6h-5v-1h6v8h-24v-8h6v1zm14 2c.552 0 1 .448 1 1s-.448 1-1 1-1-.448-1-1 .448-1 1-1zm-7.5-17v14.884l4.736-5.724.764.645-5.979 7.195-6.021-7.205.765-.644 4.735 5.732v-14.883h1z"/></svg>
                    </button>
                    <input type="file" id="file-input" accept=".json" hidden/>
                </div>
                <div>
                    <button type="button" id="show-mode" title="Visible connections">
                        <svg width="22px" height="22px" clip-rule="evenodd" fill-rule="evenodd" stroke-linejoin="round" stroke-miterlimit="2" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="m11.998 5c-4.078 0-7.742 3.093-9.853 6.483-.096.159-.145.338-.145.517s.048.358.144.517c2.112 3.39 5.776 6.483 9.854 6.483 4.143 0 7.796-3.09 9.864-6.493.092-.156.138-.332.138-.507s-.046-.351-.138-.507c-2.068-3.403-5.721-6.493-9.864-6.493zm8.413 7c-1.837 2.878-4.897 5.5-8.413 5.5-3.465 0-6.532-2.632-8.404-5.5 1.871-2.868 4.939-5.5 8.404-5.5 3.518 0 6.579 2.624 8.413 5.5zm-8.411-4c2.208 0 4 1.792 4 4s-1.792 4-4 4-4-1.792-4-4 1.792-4 4-4zm0 1.5c-1.38 0-2.5 1.12-2.5 2.5s1.12 2.5 2.5 2.5 2.5-1.12 2.5-2.5-1.12-2.5-2.5-2.5z" fill-rule="nonzero"/></svg>
                    </button>
                    <button type="button" id="hide-mode" style="display: none;" title="Hidden connections">
                        <svg width="22px" height="22px" clip-rule="evenodd" fill-rule="evenodd" stroke-linejoin="round" stroke-miterlimit="2" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="m17.069 6.546 2.684-2.359c.143-.125.32-.187.497-.187.418 0 .75.34.75.75 0 .207-.086.414-.254.562l-16.5 14.501c-.142.126-.319.187-.496.187-.415 0-.75-.334-.75-.75 0-.207.086-.414.253-.562l2.438-2.143c-1.414-1.132-2.627-2.552-3.547-4.028-.096-.159-.144-.338-.144-.517s.049-.358.145-.517c2.111-3.39 5.775-6.483 9.853-6.483 1.815 0 3.536.593 5.071 1.546zm2.319 1.83c.966.943 1.803 2.014 2.474 3.117.092.156.138.332.138.507s-.046.351-.138.507c-2.068 3.403-5.721 6.493-9.864 6.493-1.297 0-2.553-.313-3.729-.849l1.247-1.096c.795.285 1.626.445 2.482.445 3.516 0 6.576-2.622 8.413-5.5-.595-.932-1.318-1.838-2.145-2.637zm-3.434 3.019c.03.197.046.399.046.605 0 2.208-1.792 4-4 4-.384 0-.756-.054-1.107-.156l1.58-1.389c.895-.171 1.621-.821 1.901-1.671zm-.058-3.818c-1.197-.67-2.512-1.077-3.898-1.077-3.465 0-6.533 2.632-8.404 5.5.853 1.308 1.955 2.567 3.231 3.549l1.728-1.519c-.351-.595-.553-1.289-.553-2.03 0-2.208 1.792-4 4-4 .925 0 1.777.315 2.455.843zm-2.6 2.285c-.378-.23-.822-.362-1.296-.362-1.38 0-2.5 1.12-2.5 2.5 0 .36.076.701.213 1.011z" fill-rule="nonzero"/></svg>
                    </button>
                </div>
            </div>      
    
            <div id="edit-controls" class="edit-controls" style="display: none;">
                <div>
                    <button type="button" id="add-line-button" title="Add a connection">
                        <svg width="22px" height="22px" clip-rule="evenodd" fill-rule="evenodd" stroke-linejoin="round" stroke-miterlimit="2" xmlns="http://www.w3.org/2000/svg"><path d="m17.5 11c2.484 0 4.5 2.016 4.5 4.5s-2.016 4.5-4.5 4.5-4.5-2.016-4.5-4.5 2.016-4.5 4.5-4.5zm.5 4v-1.5c0-.265-.235-.5-.5-.5s-.5.235-.5.5v1.5h-1.5c-.265 0-.5.235-.5.5s.235.5.5.5h1.5v1.5c0 .265.235.5.5.5s.5-.235.5-.5c0-.592 0-1.5 0-1.5h1.5c.265 0 .5-.235.5-.5s-.235-.5-.5-.5c-.592 0-1.5 0-1.5 0zm-6.479 1c.043.522.153 1.025.321 1.5h-9.092c-.414 0-.75-.336-.75-.75s.336-.75.75-.75zm1.106-4c-.328.456-.594.96-.785 1.5h-9.092c-.414 0-.75-.336-.75-.75s.336-.75.75-.75zm7.373-3.25c0-.414-.336-.75-.75-.75h-16.5c-.414 0-.75.336-.75.75s.336.75.75.75h16.5c.414 0 .75-.336.75-.75zm0-4c0-.414-.336-.75-.75-.75h-16.5c-.414 0-.75.336-.75.75s.336.75.75.75h16.5c.414 0 .75-.336.75-.75z" fill-rule="nonzero"/></svg>
                    </button>
                </div>
                <div>
                    <button type="button" id="delete-line-button" title="Remove a connection">
                        <svg width="22px" height="22px" viewBox="0 0 24 24" clip-rule="evenodd" fill-rule="evenodd" stroke-linejoin="round" stroke-miterlimit="2" xmlns="http://www.w3.org/2000/svg"><path d="m4.015 5.494h-.253c-.413 0-.747-.335-.747-.747s.334-.747.747-.747h5.253v-1c0-.535.474-1 1-1h4c.526 0 1 .465 1 1v1h5.254c.412 0 .746.335.746.747s-.334.747-.746.747h-.254v15.435c0 .591-.448 1.071-1 1.071-2.873 0-11.127 0-14 0-.552 0-1-.48-1-1.071zm14.5 0h-13v15.006h13zm-4.25 2.506c-.414 0-.75.336-.75.75v8.5c0 .414.336.75.75.75s.75-.336.75-.75v-8.5c0-.414-.336-.75-.75-.75zm-4.5 0c-.414 0-.75.336-.75.75v8.5c0 .414.336.75.75.75s.75-.336.75-.75v-8.5c0-.414-.336-.75-.75-.75zm3.75-4v-.5h-3v.5z" fill-rule="nonzero"/></svg>
                    </button>
                </div>
            </div>
        </div>
        
        <div id="canvas-container"></div>
    </div>
    
    <div id="errorPopup" class="fixed-pop-up">
        <div class="popup-content">
            <div class="flex gap-half">
                <i class="fa fa-exclamation"></i>
                <div class="flex gap-half flex-col">
                    <h4 class="my-0">Error</h4>
                    <p class="pop-up-text" id="error-message"></p>  
                </div>
            </div>
            <i class="fa fa-times cursor-pointer" onclick="hidePopUp()"></i>
        </div>
    </div>
    
    <div class="popup-width placement-popup" id="connection-popup">
        <div class="placement-content">
            <h3 class="my-0">Create a new connection</h3>
            <div class="flex gap-1">
                <div class="flex flex-col gap-half w-100">
                    <label class="font-bold" for="connection-select-from">From:</label>
                    <select class="custom-select" id="connection-select-from">
                        <option value="none">-- Pick One --</option>
                    </select>
                </div>
            </div>
            <div class="flex gap-1">
                <div class="flex flex-col gap-half w-100">
                    <label class="font-bold" for="connection-select-to">to:</label>
                    <select class="custom-select" id="connection-select-to">
                        <option value="none">-- Pick One --</option>
                    </select>
                </div>
            </div>
            <div class="flex gap-half content-right">
                <button type="button" class="custom-button" onclick="closeLinkPopup()">Cancel</button>
                <button type="button" class="custom-button" onclick="DrawNewConnection()">Confirm</button>
            </div>
        </div>
    </div>
</div>

<script type="text/javascript">
    $LAB.script("https://unpkg.com/leaflet/dist/leaflet.js")
        .script("https://unpkg.com/konva/konva.min.js")
        .script("macrovisual/js/macrovisual.js"); 
</script>